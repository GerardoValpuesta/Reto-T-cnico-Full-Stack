{
  "name": "reto-tecnico-fullstack-talleres",
  "version": "1.0.0",
  "type": "module",
  "description": "Plataforma de reserva de talleres presenciales con alta concurrencia, paginación por cursor e idempotencia.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "tsx src/db/init.ts",
    "seed": "tsx src/db/seed.ts",
    "stress": "node stress.js --session=42 --concurrency=200"
  },
  "keywords": [
    "express",
    "postgresql",
    "concurrency",
    "idempotency",
    "cursor-pagination"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
